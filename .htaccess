# EEIS Dashboard — always serve the freshest app
# HTML must revalidate on every load so phones never show a stale build.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$|^$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# Never serve the OneDrive token store or credentials directly
<FilesMatch "^ms_(tokens\.json|config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
